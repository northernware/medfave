// use prisma-next
// Contract inferred from the live database schema. Edit as needed, then run `prisma contract emit`.

namespace public {
  model Doctor {
    id             String          @id(map: "Doctor_pkey")
    email          String
    passwordHash   String
    fullName       String
    specialty      String?
    licenseNumber  String?
    clinicName     String?
    createdAt      TimestampString(3)    @default(now())
    updatedAt      TimestampString(3)
    appointments   Appointment[]
    households     Household[]
    medicalRecords MedicalRecord[] @relation(name: "MedicalRecord_doctorId_fkey")
    followUpsClosed MedicalRecord[] @relation(name: "MedicalRecord_followUpClosedById_fkey")
    recordsFinalized MedicalRecord[] @relation(name: "MedicalRecord_finalizedById_fkey")
    recordsArchived  MedicalRecord[] @relation(name: "MedicalRecord_archivedById_fkey")
    recordVersions   MedicalRecordVersion[]
    scheduleSettings ScheduleSettings?
    clinicHours      ClinicHours[]
    clinicBreaks     ClinicBreak[]
    clinicClosures   ClinicClosure[]
    serviceDurations ServiceDuration[]

    @@index([email], map: "Doctor_email_key", unique: true)

    @@map("Doctor")
  }

  model Household {
    id            String       @id(map: "Household_pkey")
    doctorId      String
    name          String
    address       String?
    contactNumber String?
    notes         String?
    // Who to call for this household, and the guardian for any dependants in it.
    // SetNull rather than Cascade: losing the contact must not take the household.
    primaryContactId String?
    createdAt     TimestampString(3) @default(now())
    updatedAt     TimestampString(3)
    patients      Patient[]
    primaryContact Patient?    @relation("HouseholdPrimaryContact", fields: [primaryContactId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "Household_primaryContactId_fkey")
    doctor        Doctor       @relation(fields: [doctorId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "Household_doctorId_fkey")

    @@index([doctorId], map: "Household_doctorId_idx")
    @@index([doctorId, name], map: "Household_doctorId_name_key", unique: true)
    @@index([primaryContactId], map: "Household_primaryContactId_key", unique: true)

    @@map("Household")
  }

  model Patient {
    id                String                      @id(map: "Patient_pkey")

    // Human-readable identity, e.g. MK-2026-000123. Unique and searchable, and
    // never reused — it is what staff and printed documents quote. The primary
    // key stays the internal id; this is never a foreign key.
    //
    // Nullable only so the column can be added to a populated table without a
    // fragile in-migration backfill; every write path assigns one, and the
    // backfill script fills any row that predates the column. Postgres allows
    // many NULLs under a unique index, so uniqueness still holds throughout.
    patientNumber     String?
    householdId       String
    firstName         String
    middleName        String?
    lastName          String
    dateOfBirth       DateString
    sex               pg.enum(Sex)
    relationship      pg.enum(Relationship)       @default("OTHER")
    bloodType         pg.enum(BloodType)          @default("UNKNOWN")
    contactNumber     String?
    email             String?
    createdAt         TimestampString(3)                @default(now())
    updatedAt         TimestampString(3)
    allergyStatus     pg.enum(ClinicalListStatus) @default("UNKNOWN")
    conditionStatus   pg.enum(ClinicalListStatus) @default("UNKNOWN")
    medicationStatus  pg.enum(ClinicalListStatus) @default("UNKNOWN")
    // The person to ring is often outside the practice, so this is free text
    // rather than a link to another Patient.
    emergencyContactName         String?
    emergencyContactRelationship String?
    emergencyContactNumber       String?
    appointments      Appointment[]
    medicalRecords    MedicalRecord[]
    allergies         PatientAllergy[]
    conditions        PatientCondition[]
    medications       PatientMedication[]
    alerts            PatientAlert[]
    primaryContactFor Household[]                 @relation("HouseholdPrimaryContact")
    household         Household                   @relation(fields: [householdId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "Patient_householdId_fkey")

    @@index([patientNumber], map: "Patient_patientNumber_key", unique: true)
    @@index([householdId], map: "Patient_householdId_idx")
    @@index([lastName, firstName], map: "Patient_lastName_firstName_idx")

    @@map("Patient")
  }

  model Appointment {
    id                         String                      @id(map: "Appointment_pkey")
    patientId                  String
    doctorId                   String
    scheduledAt                TimestampString(3)
    durationMinutes            Int                         @default(30)
    reason                     String
    status                     pg.enum(AppointmentStatus)  @default("PENDING")
    notes                      String?
    createdAt                  TimestampString(3)                @default(now())
    updatedAt                  TimestampString(3)
    service                    pg.enum(ServiceType)        @default("GENERAL_CONSULTATION")
    internalNotes              String?
    previousAppointmentId      String?
    priority                   pg.enum(VisitPriority)      @default("ROUTINE")
    reminderPreference         pg.enum(ReminderPreference) @default("NONE")
    room                       String?
    source                     pg.enum(BookingSource)      @default("STAFF")
    visitType                  pg.enum(AppointmentType)    @default("IN_PERSON") @map("type")
    /// When the patient physically arrived. Set on check-in, and on a walk-in
    /// at the moment it is registered — the queue is ordered by it, not by the
    /// scheduled time, because a walk-in has no meaningful scheduled time.
    arrivedAt                  TimestampString(3)?
    /// When the doctor actually started seeing them, stamped on the move into
    /// IN_CONSULTATION. Waiting time is arrival to this, so it stops climbing
    /// once the patient is in the room instead of running until check-out.
    consultationStartedAt      TimestampString(3)?
    doctor                     Doctor                      @relation(fields: [doctorId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "Appointment_doctorId_fkey", index: false)
    patient                    Patient                     @relation(fields: [patientId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "Appointment_patientId_fkey")
    previousAppointment        Appointment?                @relation(name: "Appointment_previousAppointmentId_fkey", fields: [previousAppointmentId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "Appointment_previousAppointmentId_fkey")
    followUps                  Appointment[]               @relation(name: "Appointment_previousAppointmentId_fkey")
    medicalRecord              MedicalRecord?              @relation(name: "MedicalRecord_appointmentId_fkey")
    followUpForRecord          MedicalRecord?              @relation(name: "MedicalRecord_followUpAppointmentId_fkey")

    @@index([doctorId, scheduledAt], map: "Appointment_doctorId_scheduledAt_idx")
    @@index([patientId], map: "Appointment_patientId_idx")
    @@index([previousAppointmentId], map: "Appointment_previousAppointmentId_idx")

    @@map("Appointment")
  }

  model MedicalRecord {
    id                      String         @id(map: "MedicalRecord_pkey")
    patientId               String
    doctorId                String
    appointmentId           String?
    visitDate               TimestampString(3)   @default(now())
    chiefComplaint          String
    historyOfPresentIllness String?
    temperatureC            Float?
    heartRate               Int?
    respiratoryRate         Int?
    systolic                Int?
    diastolic               Int?
    weightKg                Float?
    heightCm                Float?
    oxygenSaturation        Int?
    assessment              String?
    treatmentPlan           String?
    followUpDate            DateString?
    notes                   String?
    createdAt               TimestampString(3)   @default(now())
    updatedAt               TimestampString(3)
    followUpAppointmentId   String?
    physicalExamination     String?

    /// Where the note stands. A DRAFT is the doctor's working copy and can be
    /// changed freely; FINALIZED means it has been signed, and after that every
    /// change is an amendment that keeps the previous text (see
    /// MedicalRecordVersion), which is what AMENDED marks.
    ///
    /// The default describes rows written before drafts existed: those notes
    /// were finished and in use, so they are finalized. Every write path states
    /// the status explicitly rather than relying on it.
    status                  pg.enum(RecordStatus) @default("FINALIZED")
    /// When it was signed, and by whom. Null while it is still a draft.
    finalizedAt             TimestampString(3)?
    finalizedById           String?

    /// A clinical record is not deleted. Archiving hides it from the ordinary
    /// lists while leaving it readable and restorable, and says who did it and
    /// why — the parts a hard delete throws away.
    archivedAt              TimestampString(3)?
    archivedById            String?
    archiveReason           String?

    // Closing a follow-up is a decision someone makes, so it is recorded rather
    // than inferred. Everything else about follow-up state is derived from the
    // linked appointment's status — see `followUpState` in lib/follow-up.ts.
    followUpClosedAt        TimestampString(3)?
    followUpClosedReason    String?
    followUpClosedById      String?

    prescriptions           Prescription[]
    versions                MedicalRecordVersion[]
    finalizedBy             Doctor?        @relation(name: "MedicalRecord_finalizedById_fkey", fields: [finalizedById], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "MedicalRecord_finalizedById_fkey")
    archivedBy              Doctor?        @relation(name: "MedicalRecord_archivedById_fkey", fields: [archivedById], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "MedicalRecord_archivedById_fkey")
    appointment             Appointment?   @relation(name: "MedicalRecord_appointmentId_fkey", fields: [appointmentId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "MedicalRecord_appointmentId_fkey")
    doctor                  Doctor         @relation(name: "MedicalRecord_doctorId_fkey", fields: [doctorId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "MedicalRecord_doctorId_fkey")
    followUpAppointment     Appointment?   @relation(name: "MedicalRecord_followUpAppointmentId_fkey", fields: [followUpAppointmentId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "MedicalRecord_followUpAppointmentId_fkey")
    followUpClosedBy        Doctor?        @relation(name: "MedicalRecord_followUpClosedById_fkey", fields: [followUpClosedById], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "MedicalRecord_followUpClosedById_fkey")
    patient                 Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "MedicalRecord_patientId_fkey", index: false)

    @@unique([appointmentId], map: "MedicalRecord_appointmentId_key")
    @@unique([followUpAppointmentId], map: "MedicalRecord_followUpAppointmentId_key")
    @@index([doctorId], map: "MedicalRecord_doctorId_idx")
    @@index([followUpClosedById], map: "MedicalRecord_followUpClosedById_idx")
    @@index([finalizedById], map: "MedicalRecord_finalizedById_idx")
    @@index([archivedById], map: "MedicalRecord_archivedById_idx")
    @@index([patientId, visitDate], map: "MedicalRecord_patientId_visitDate_idx")

    @@map("MedicalRecord")
  }

  model PatientAllergy {
    id        String                    @id(map: "PatientAllergy_pkey")
    patientId String
    label     String
    reaction  String?
    severity  pg.enum(AllergySeverity)?
    notes     String?
    createdAt TimestampString(3)              @default(now())
    patient   Patient                   @relation(fields: [patientId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "PatientAllergy_patientId_fkey")

    @@index([patientId], map: "PatientAllergy_patientId_idx")
    @@index([patientId, label], map: "PatientAllergy_patientId_label_key", unique: true)

    @@map("PatientAllergy")
  }

  model PatientCondition {
    id        String       @id(map: "PatientCondition_pkey")
    patientId String
    label     String
    notes     String?
    createdAt TimestampString(3) @default(now())
    patient   Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "PatientCondition_patientId_fkey")

    @@index([patientId], map: "PatientCondition_patientId_idx")
    @@index([patientId, label], map: "PatientCondition_patientId_label_key", unique: true)

    @@map("PatientCondition")
  }

  // A medicine the patient is currently taking — distinct from a Prescription,
  // which records what was issued at one visit.
  model PatientMedication {
    id        String       @id(map: "PatientMedication_pkey")
    patientId String
    label     String
    dosage    String?
    frequency String?
    notes     String?
    createdAt TimestampString(3) @default(now())
    patient   Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "PatientMedication_patientId_fkey")

    @@index([patientId], map: "PatientMedication_patientId_idx")
    @@index([patientId, label], map: "PatientMedication_patientId_label_key", unique: true)

    @@map("PatientMedication")
  }

  // A standing warning that belongs at the top of the chart — anticoagulants, a
  // pacemaker, a difficult airway. Separate from conditions because these are
  // things to act on before touching the patient, not history.
  model PatientAlert {
    id        String       @id(map: "PatientAlert_pkey")
    patientId String
    label     String
    notes     String?
    createdAt TimestampString(3) @default(now())
    patient   Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "PatientAlert_patientId_fkey")

    @@index([patientId], map: "PatientAlert_patientId_idx")
    @@index([patientId, label], map: "PatientAlert_patientId_label_key", unique: true)

    @@map("PatientAlert")
  }

  // One row per year, holding the last number handed out. Allocation bumps it
  // inside the patient's own transaction, so two concurrent registrations
  // cannot receive the same number, and a rolled-back registration still burns
  // it — numbers are never reused, by design.
  model PatientNumberCounter {
    year     Int    @id(map: "PatientNumberCounter_pkey")
    lastUsed Int    @default(0)

    @@map("PatientNumberCounter")
  }

  // --- Scheduling settings -------------------------------------------------
  // Availability used to be three module constants. It is now data, so a clinic
  // can describe its own week, its breaks, and the days it is shut.

  /// One row per doctor. Absent means the defaults in lib/scheduling.ts apply.
  model ScheduleSettings {
    doctorId          String  @id(map: "ScheduleSettings_pkey")
    slotStepMinutes   Int     @default(15)
    /// How far ahead a booking must be made. Zero lets walk-ins be booked today.
    minLeadMinutes    Int     @default(1440)
    maxLeadDays       Int     @default(180)
    defaultDurationMinutes Int @default(30)
    doctor            Doctor  @relation(fields: [doctorId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "ScheduleSettings_doctorId_fkey")

    @@map("ScheduleSettings")
  }

  /// A working day. A weekday with no row is a day the clinic does not open.
  model ClinicHours {
    id          String @id(map: "ClinicHours_pkey")
    doctorId    String
    /// 0 = Sunday .. 6 = Saturday.
    weekday     Int
    openMinute  Int
    closeMinute Int
    doctor      Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "ClinicHours_doctorId_fkey")

    @@index([doctorId, weekday], map: "ClinicHours_doctorId_weekday_key", unique: true)

    @@map("ClinicHours")
  }

  /// A recurring break — lunch, a teaching slot. Null weekday means every day.
  model ClinicBreak {
    id          String  @id(map: "ClinicBreak_pkey")
    doctorId    String
    weekday     Int?
    startMinute Int
    endMinute   Int
    label       String
    doctor      Doctor  @relation(fields: [doctorId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "ClinicBreak_doctorId_fkey")

    @@index([doctorId], map: "ClinicBreak_doctorId_idx")

    @@map("ClinicBreak")
  }

  /// A one-off closure: a holiday, leave, or a blocked range within a day.
  /// `startMinute`/`endMinute` null means the whole day is blocked.
  model ClinicClosure {
    id          String      @id(map: "ClinicClosure_pkey")
    doctorId    String
    startsOn    DateString
    endsOn      DateString
    startMinute Int?
    endMinute   Int?
    reason      String
    doctor      Doctor      @relation(fields: [doctorId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "ClinicClosure_doctorId_fkey")

    @@index([doctorId, startsOn], map: "ClinicClosure_doctorId_startsOn_idx")

    @@map("ClinicClosure")
  }

  /// Overrides the built-in length for one service.
  model ServiceDuration {
    id       String              @id(map: "ServiceDuration_pkey")
    doctorId String
    service  pg.enum(ServiceType)
    minutes  Int
    doctor   Doctor              @relation(fields: [doctorId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "ServiceDuration_doctorId_fkey")

    @@index([doctorId, service], map: "ServiceDuration_doctorId_service_key", unique: true)

    @@map("ServiceDuration")
  }

  /// One signed state of a record, kept forever.
  ///
  /// Version 1 is the text as first signed; every amendment writes the state it
  /// replaced before the new text lands, so the trail answers "what did this
  /// note say when the decision was made" — which is the question a clinical
  /// record exists to answer.
  model MedicalRecordVersion {
    id              String        @id(map: "MedicalRecordVersion_pkey")
    medicalRecordId String
    /// 1 for the original signature, then upwards.
    version         Int
    /// The clinical fields as they stood, JSON-encoded. Held as text because it
    /// is only ever read back whole, to show or compare one past version.
    snapshot        String
    /// Why the change was made. Null on the original signature — there is no
    /// prior state to explain.
    reason          String?
    authorId        String
    createdAt       TimestampString(3) @default(now())
    medicalRecord   MedicalRecord @relation(fields: [medicalRecordId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "MedicalRecordVersion_medicalRecordId_fkey", index: false)
    author          Doctor        @relation(fields: [authorId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "MedicalRecordVersion_authorId_fkey")

    @@index([medicalRecordId, version], map: "MedicalRecordVersion_recordId_version_key", unique: true)
    @@index([authorId], map: "MedicalRecordVersion_authorId_idx")

    @@map("MedicalRecordVersion")
  }

  model Prescription {
    id              String        @id(map: "Prescription_pkey")
    medicalRecordId String
    drugName        String
    dosage          String
    frequency       String
    duration        String?
    instructions    String?
    createdAt       TimestampString(3)  @default(now())
    medicalRecord   MedicalRecord @relation(fields: [medicalRecordId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "Prescription_medicalRecordId_fkey")

    @@index([medicalRecordId], map: "Prescription_medicalRecordId_idx")

    @@map("Prescription")
  }

  native_enum AllergySeverity {
    MILD = "MILD"
    MODERATE = "MODERATE"
    SEVERE = "SEVERE"
  }

  native_enum AppointmentStatus {
    PENDING = "PENDING"
    CONFIRMED = "CONFIRMED"
    CHECKED_IN = "CHECKED_IN"
    COMPLETED = "COMPLETED"
    CANCELLED = "CANCELLED"
    NO_SHOW = "NO_SHOW"
    // Appended rather than slotted in after CHECKED_IN, where it belongs in the
    // queue's order: Postgres native enums can only be added to, and Prisma
    // Next refuses anything that would reorder existing values. The order staff
    // see comes from APPOINTMENT_STATUS_LABELS, not from this declaration.
    IN_CONSULTATION = "IN_CONSULTATION"
  }

  native_enum AppointmentType {
    IN_PERSON = "IN_PERSON"
    TELECONSULTATION = "TELECONSULTATION"
    HOME_VISIT = "HOME_VISIT"
  }

  native_enum BloodType {
    A_POS = "A_POS"
    A_NEG = "A_NEG"
    B_POS = "B_POS"
    B_NEG = "B_NEG"
    AB_POS = "AB_POS"
    AB_NEG = "AB_NEG"
    O_POS = "O_POS"
    O_NEG = "O_NEG"
    UNKNOWN = "UNKNOWN"
  }

  native_enum BookingSource {
    STAFF = "STAFF"
    WALK_IN = "WALK_IN"
    PHONE = "PHONE"
    PATIENT_PORTAL = "PATIENT_PORTAL"
  }

  native_enum ClinicalListStatus {
    RECORDED = "RECORDED"
    NONE_KNOWN = "NONE_KNOWN"
    UNKNOWN = "UNKNOWN"
  }

  native_enum RecordStatus {
    DRAFT = "DRAFT"
    FINALIZED = "FINALIZED"
    AMENDED = "AMENDED"
  }

  native_enum Relationship {
    HEAD = "HEAD"
    SPOUSE = "SPOUSE"
    CHILD = "CHILD"
    PARENT = "PARENT"
    SIBLING = "SIBLING"
    GRANDPARENT = "GRANDPARENT"
    OTHER = "OTHER"
  }

  native_enum ReminderPreference {
    NONE = "NONE"
    SMS = "SMS"
    EMAIL = "EMAIL"
    APP = "APP"
  }

  native_enum ServiceType {
    GENERAL_CONSULTATION = "GENERAL_CONSULTATION"
    FAMILY_CHECKUP = "FAMILY_CHECKUP"
    FOLLOW_UP_CHECKUP = "FOLLOW_UP_CHECKUP"
    ROUTINE_PHYSICAL_EXAM = "ROUTINE_PHYSICAL_EXAM"
    PEDIATRIC_CONSULTATION = "PEDIATRIC_CONSULTATION"
    SENIOR_CITIZEN_CONSULTATION = "SENIOR_CITIZEN_CONSULTATION"
    PRENATAL_POSTNATAL_CONSULTATION = "PRENATAL_POSTNATAL_CONSULTATION"
    CHRONIC_DISEASE_MANAGEMENT = "CHRONIC_DISEASE_MANAGEMENT"
    PRESCRIPTION_RENEWAL = "PRESCRIPTION_RENEWAL"
    LABORATORY_RESULT_REVIEW = "LABORATORY_RESULT_REVIEW"
    MEDICAL_CERTIFICATE_REQUEST = "MEDICAL_CERTIFICATE_REQUEST"
    VACCINATION_CONSULTATION = "VACCINATION_CONSULTATION"
    MINOR_INJURY_WOUND_CARE = "MINOR_INJURY_WOUND_CARE"
    TELECONSULTATION = "TELECONSULTATION"
    REFERRAL_CONSULTATION = "REFERRAL_CONSULTATION"
  }

  native_enum Sex {
    MALE = "MALE"
    FEMALE = "FEMALE"
  }

  native_enum VisitPriority {
    ROUTINE = "ROUTINE"
    URGENT = "URGENT"
    FOLLOW_UP = "FOLLOW_UP"
  }
}
