    ADMIN = "ADMIN"
  }

  native_enum AppointmentRequestStatus {
    PENDING = "PENDING"
    ACCEPTED = "ACCEPTED"
    DECLINED = "DECLINED"
    WITHDRAWN = "WITHDRAWN"
  }

  native_enum RecordStatus {
