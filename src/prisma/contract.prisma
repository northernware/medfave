// use prisma-next
// Contract inferred from the live database schema. Edit as needed, then run `prisma contract emit`.

namespace public {
  model Doctor {
    id             String          @id(map: "Doctor_pkey")
    /// The practice this clinician works in. Everything they own is the
    /// clinic's; this is what a secretary's access is scoped by.
    clinicId       String?
    /// Their login. Nullable only so the column could be added to populated
    /// rows — every clinician has one after the backfill.
    accountId      String?
    fullName       String
    specialty      String?
    licenseNumber  String?
    clinicName     String?
    createdAt      TimestampString(3)    @default(now())
    updatedAt      TimestampString(3)
    appointments   Appointment[]
    households     Household[]
    medicalRecords MedicalRecord[] @relation(name: "MedicalRecord_doctorId_fkey")
    followUpsClosed MedicalRecord[] @relation(name: "MedicalRecord_followUpClosedById_fkey")
    recordsFinalized MedicalRecord[] @relation(name: "MedicalRecord_finalizedById_fkey")
    recordsArchived  MedicalRecord[] @relation(name: "MedicalRecord_archivedById_fkey")
    recordVersions   MedicalRecordVersion[]
    documentRequests DocumentRequest[]      @relation(name: "DocumentRequest_doctorId_fkey")
    documentsReleased DocumentRequest[]     @relation(name: "DocumentRequest_releasedById_fkey")
    clinic         Clinic?         @relation(fields: [clinicId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "Doctor_clinicId_fkey")
    account        Account?        @relation(fields: [accountId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "Doctor_accountId_fkey")
    appointmentRequests AppointmentRequest[]
    scheduleSettings ScheduleSettings?
    clinicHours      ClinicHours[]
    clinicBreaks     ClinicBreak[]
    clinicClosures   ClinicClosure[]
    serviceDurations ServiceDuration[]

    @@unique([accountId], map: "Doctor_accountId_key")
    @@index([clinicId], map: "Doctor_clinicId_idx")

    @@map("Doctor")
  }

  model Household {
    id            String       @id(map: "Household_pkey")
    /// Who owns this record. `doctorId` still says which clinician it was
    /// entered under; this is the boundary every query is scoped by.
    clinicId      String?
    doctorId      String
    name          String
    address       String?
    contactNumber String?
    notes         String?
    // Who to call for this household, and the guardian for any dependants in it.
    // SetNull rather than Cascade: losing the contact must not take the household.
    primaryContactId String?
    createdAt     TimestampString(3) @default(now())
    updatedAt     TimestampString(3)
    patients      Patient[]
    primaryContact Patient?    @relation("HouseholdPrimaryContact", fields: [primaryContactId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "Household_primaryContactId_fkey")
    doctor        Doctor       @relation(fields: [doctorId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "Household_doctorId_fkey")
    clinic        Clinic?      @relation(fields: [clinicId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "Household_clinicId_fkey")

    @@index([doctorId], map: "Household_doctorId_idx")
    @@index([clinicId], map: "Household_clinicId_idx")
    @@index([doctorId, name], map: "Household_doctorId_name_key", unique: true)
    @@index([primaryContactId], map: "Household_primaryContactId_key", unique: true)

    @@map("Household")
  }

  model Patient {
    id                String                      @id(map: "Patient_pkey")
    /// Who holds this chart. Reachable through the household as well, but a
    /// person's own clinic is asked for on nearly every request the portal
    /// makes, and a join for it every time is a join too many.
    clinicId          String?
    /// The login that belongs to this person, once they have activated one.
    /// Null is ordinary and permanent for most patients: a chart does not need
    /// a login to be a chart.
    accountId         String?

    // Human-readable identity, e.g. MK-2026-000123. Unique and searchable, and
    // never reused — it is what staff and printed documents quote. The primary
    // key stays the internal id; this is never a foreign key.
    //
    // Nullable only so the column can be added to a populated table without a
    // fragile in-migration backfill; every write path assigns one, and the
    // backfill script fills any row that predates the column. Postgres allows
    // many NULLs under a unique index, so uniqueness still holds throughout.
    patientNumber     String?
    householdId       String
    firstName         String
    middleName        String?
    lastName          String
    dateOfBirth       DateString
    sex               pg.enum(Sex)
    relationship      pg.enum(Relationship)       @default("OTHER")
    bloodType         pg.enum(BloodType)          @default("UNKNOWN")
    contactNumber     String?
    email             String?
    /// Whether this person wants to hear from the clinic before a visit, and
    /// how. Theirs to set from the portal, and the default every new
    /// appointment takes; the copy on the appointment is what actually decides
    /// a send, so a change here never rewrites what was promised for a visit
    /// that has already been reminded.
    reminderPreference pg.enum(ReminderPreference) @default("NONE")
    createdAt         TimestampString(3)                @default(now())
    updatedAt         TimestampString(3)
    allergyStatus     pg.enum(ClinicalListStatus) @default("UNKNOWN")
    conditionStatus   pg.enum(ClinicalListStatus) @default("UNKNOWN")
    medicationStatus  pg.enum(ClinicalListStatus) @default("UNKNOWN")
    // The person to ring is often outside the practice, so this is free text
    // rather than a link to another Patient.
    emergencyContactName         String?
    emergencyContactRelationship String?
    emergencyContactNumber       String?
    appointments      Appointment[]
    medicalRecords    MedicalRecord[]
    allergies         PatientAllergy[]
    conditions        PatientCondition[]
    medications       PatientMedication[]
    alerts            PatientAlert[]
    documentRequests  DocumentRequest[]
    activations       PatientActivation[]
    appointmentRequests AppointmentRequest[]
    account           Account?                    @relation(fields: [accountId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "Patient_accountId_fkey")
    clinic            Clinic?                     @relation(fields: [clinicId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "Patient_clinicId_fkey")
    primaryContactFor Household[]                 @relation("HouseholdPrimaryContact")
    household         Household                   @relation(fields: [householdId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "Patient_householdId_fkey")

    @@index([patientNumber], map: "Patient_patientNumber_key", unique: true)
    @@unique([accountId], map: "Patient_accountId_key")
    @@index([householdId], map: "Patient_householdId_idx")
    @@index([clinicId], map: "Patient_clinicId_idx")
    @@index([lastName, firstName], map: "Patient_lastName_firstName_idx")

    @@map("Patient")
  }

  model Appointment {
    id                         String                      @id(map: "Appointment_pkey")
    clinicId                   String?
    patientId                  String
    /// The clinician the visit is with — not necessarily whoever booked it.
    doctorId                   String
    /// Who made the booking. Kept apart from `doctorId` on purpose: a
    /// secretary books, a doctor is booked, and the record of a consultation
    /// should never be attributed to the person who answered the phone.
    bookedById                 String?
    scheduledAt                TimestampString(3)
    durationMinutes            Int                         @default(30)
    reason                     String
    status                     pg.enum(AppointmentStatus)  @default("PENDING")
    notes                      String?
    createdAt                  TimestampString(3)                @default(now())
    updatedAt                  TimestampString(3)
    service                    pg.enum(ServiceType)        @default("GENERAL_CONSULTATION")
    internalNotes              String?
    previousAppointmentId      String?
    priority                   pg.enum(VisitPriority)      @default("ROUTINE")
    reminderPreference         pg.enum(ReminderPreference) @default("NONE")
    room                       String?
    source                     pg.enum(BookingSource)      @default("STAFF")
    visitType                  pg.enum(AppointmentType)    @default("IN_PERSON") @map("type")
    /// When the patient physically arrived. Set on check-in, and on a walk-in
    /// at the moment it is registered — the queue is ordered by it, not by the
    /// scheduled time, because a walk-in has no meaningful scheduled time.
    arrivedAt                  TimestampString(3)?
    /// When the booking confirmation went out, and when the reminder did.
    ///
    /// Recorded rather than inferred from the clock, because "has this already
    /// been sent" is the only thing standing between a patient and the same
    /// message four times. A null here means not yet; it is never re-cleared.
    confirmationSentAt         TimestampString(3)?
    reminderSentAt             TimestampString(3)?
    /// Set when the clinic marked this a no-show on its own, because nobody
    /// said anything about it for long enough after the scheduled time. Kept
    /// apart from a no-show a person recorded: the page can then say the
    /// clinic assumed it rather than that someone decided it, and offer to
    /// rebook. Cleared the moment the status moves anywhere else.
    autoNoShowAt               TimestampString(3)?
    /// When the doctor actually started seeing them, stamped on the move into
    /// IN_CONSULTATION. Waiting time is arrival to this, so it stops climbing
    /// once the patient is in the room instead of running until check-out.
    consultationStartedAt      TimestampString(3)?
    doctor                     Doctor                      @relation(fields: [doctorId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "Appointment_doctorId_fkey", index: false)
    clinic                     Clinic?                     @relation(fields: [clinicId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "Appointment_clinicId_fkey")
    bookedBy                   Account?                    @relation(name: "Appointment_bookedById_fkey", fields: [bookedById], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "Appointment_bookedById_fkey")
    appointmentRequests        AppointmentRequest[]
    patient                    Patient                     @relation(fields: [patientId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "Appointment_patientId_fkey")
    previousAppointment        Appointment?                @relation(name: "Appointment_previousAppointmentId_fkey", fields: [previousAppointmentId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "Appointment_previousAppointmentId_fkey")
    followUps                  Appointment[]               @relation(name: "Appointment_previousAppointmentId_fkey")
    medicalRecord              MedicalRecord?              @relation(name: "MedicalRecord_appointmentId_fkey")
    followUpForRecord          MedicalRecord?              @relation(name: "MedicalRecord_followUpAppointmentId_fkey")

    @@index([doctorId, scheduledAt], map: "Appointment_doctorId_scheduledAt_idx")
    @@index([patientId], map: "Appointment_patientId_idx")
    @@index([clinicId, scheduledAt], map: "Appointment_clinicId_scheduledAt_idx")
    @@index([bookedById], map: "Appointment_bookedById_idx")
    @@index([previousAppointmentId], map: "Appointment_previousAppointmentId_idx")

    @@map("Appointment")
  }

  model MedicalRecord {
    id                      String         @id(map: "MedicalRecord_pkey")
    clinicId                String?
    patientId               String
    /// The clinician who wrote it. Authorship, never a permission check.
    doctorId                String
    appointmentId           String?
    visitDate               TimestampString(3)   @default(now())
    chiefComplaint          String
    historyOfPresentIllness String?
    temperatureC            Float?
    heartRate               Int?
    respiratoryRate         Int?
    systolic                Int?
    diastolic               Int?
    weightKg                Float?
    heightCm                Float?
    oxygenSaturation        Int?
    assessment              String?
    treatmentPlan           String?
    followUpDate            DateString?
    notes                   String?
    createdAt               TimestampString(3)   @default(now())
    updatedAt               TimestampString(3)
    followUpAppointmentId   String?
    physicalExamination     String?

    /// Where the note stands. A DRAFT is the doctor's working copy and can be
    /// changed freely; FINALIZED means it has been signed, and after that every
    /// change is an amendment that keeps the previous text (see
    /// MedicalRecordVersion), which is what AMENDED marks.
    ///
    /// The default describes rows written before drafts existed: those notes
    /// were finished and in use, so they are finalized. Every write path states
    /// the status explicitly rather than relying on it.
    status                  pg.enum(RecordStatus) @default("FINALIZED")
    /// When it was signed, and by whom. Null while it is still a draft.
    finalizedAt             TimestampString(3)?
    finalizedById           String?

    /// A clinical record is not deleted. Archiving hides it from the ordinary
    /// lists while leaving it readable and restorable, and says who did it and
    /// why — the parts a hard delete throws away.
    archivedAt              TimestampString(3)?
    archivedById            String?
    archiveReason           String?

    // Closing a follow-up is a decision someone makes, so it is recorded rather
    // than inferred. Everything else about follow-up state is derived from the
    // linked appointment's status — see `followUpState` in lib/follow-up.ts.
    followUpClosedAt        TimestampString(3)?
    followUpClosedReason    String?
    followUpClosedById      String?

    prescriptions           Prescription[]
    versions                MedicalRecordVersion[]
    clinic                  Clinic?        @relation(fields: [clinicId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "MedicalRecord_clinicId_fkey")
    documentRequests        DocumentRequest[]
    finalizedBy             Doctor?        @relation(name: "MedicalRecord_finalizedById_fkey", fields: [finalizedById], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "MedicalRecord_finalizedById_fkey")
    archivedBy              Doctor?        @relation(name: "MedicalRecord_archivedById_fkey", fields: [archivedById], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "MedicalRecord_archivedById_fkey")
    appointment             Appointment?   @relation(name: "MedicalRecord_appointmentId_fkey", fields: [appointmentId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "MedicalRecord_appointmentId_fkey")
    doctor                  Doctor         @relation(name: "MedicalRecord_doctorId_fkey", fields: [doctorId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "MedicalRecord_doctorId_fkey")
    followUpAppointment     Appointment?   @relation(name: "MedicalRecord_followUpAppointmentId_fkey", fields: [followUpAppointmentId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "MedicalRecord_followUpAppointmentId_fkey")
    followUpClosedBy        Doctor?        @relation(name: "MedicalRecord_followUpClosedById_fkey", fields: [followUpClosedById], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "MedicalRecord_followUpClosedById_fkey")
    patient                 Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "MedicalRecord_patientId_fkey", index: false)

    @@unique([appointmentId], map: "MedicalRecord_appointmentId_key")
    @@unique([followUpAppointmentId], map: "MedicalRecord_followUpAppointmentId_key")
    @@index([doctorId], map: "MedicalRecord_doctorId_idx")
    @@index([clinicId], map: "MedicalRecord_clinicId_idx")
    @@index([followUpClosedById], map: "MedicalRecord_followUpClosedById_idx")
    @@index([finalizedById], map: "MedicalRecord_finalizedById_idx")
    @@index([archivedById], map: "MedicalRecord_archivedById_idx")
    @@index([patientId, visitDate], map: "MedicalRecord_patientId_visitDate_idx")

    @@map("MedicalRecord")
  }

  model PatientAllergy {
    id        String                    @id(map: "PatientAllergy_pkey")
    patientId String
    label     String
    reaction  String?
    severity  pg.enum(AllergySeverity)?
    notes     String?
    createdAt TimestampString(3)              @default(now())
    patient   Patient                   @relation(fields: [patientId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "PatientAllergy_patientId_fkey")

    @@index([patientId], map: "PatientAllergy_patientId_idx")
    @@index([patientId, label], map: "PatientAllergy_patientId_label_key", unique: true)

    @@map("PatientAllergy")
  }

  model PatientCondition {
    id        String       @id(map: "PatientCondition_pkey")
    patientId String
    label     String
    notes     String?
    createdAt TimestampString(3) @default(now())
    patient   Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "PatientCondition_patientId_fkey")

    @@index([patientId], map: "PatientCondition_patientId_idx")
    @@index([patientId, label], map: "PatientCondition_patientId_label_key", unique: true)

    @@map("PatientCondition")
  }

  // A medicine the patient is currently taking — distinct from a Prescription,
  // which records what was issued at one visit.
  model PatientMedication {
    id        String       @id(map: "PatientMedication_pkey")
    patientId String
    label     String
    dosage    String?
    frequency String?
    notes     String?
    createdAt TimestampString(3) @default(now())
    patient   Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "PatientMedication_patientId_fkey")

    @@index([patientId], map: "PatientMedication_patientId_idx")
    @@index([patientId, label], map: "PatientMedication_patientId_label_key", unique: true)

    @@map("PatientMedication")
  }

  // A standing warning that belongs at the top of the chart — anticoagulants, a
  // pacemaker, a difficult airway. Separate from conditions because these are
  // things to act on before touching the patient, not history.
  model PatientAlert {
    id        String       @id(map: "PatientAlert_pkey")
    patientId String
    label     String
    notes     String?
    createdAt TimestampString(3) @default(now())
    patient   Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "PatientAlert_patientId_fkey")

    @@index([patientId], map: "PatientAlert_patientId_idx")
    @@index([patientId, label], map: "PatientAlert_patientId_label_key", unique: true)

    @@map("PatientAlert")
  }

  // One row per year, holding the last number handed out. Allocation bumps it
  // inside the patient's own transaction, so two concurrent registrations
  // cannot receive the same number, and a rolled-back registration still burns
  // it — numbers are never reused, by design.
  model PatientNumberCounter {
    year     Int    @id(map: "PatientNumberCounter_pkey")
    lastUsed Int    @default(0)

    @@map("PatientNumberCounter")
  }

  // --- Scheduling settings -------------------------------------------------
  // Availability used to be three module constants. It is now data, so a clinic
  // can describe its own week, its breaks, and the days it is shut.

  /// One row per doctor. Absent means the defaults in lib/scheduling.ts apply.
  model ScheduleSettings {
    doctorId          String  @id(map: "ScheduleSettings_pkey")
    slotStepMinutes   Int     @default(15)
    /// How far ahead a booking must be made. Zero lets walk-ins be booked today.
    minLeadMinutes    Int     @default(1440)
    maxLeadDays       Int     @default(180)
    defaultDurationMinutes Int @default(30)
    doctor            Doctor  @relation(fields: [doctorId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "ScheduleSettings_doctorId_fkey")

    @@map("ScheduleSettings")
  }

  /// A working day. A weekday with no row is a day the clinic does not open.
  model ClinicHours {
    id          String @id(map: "ClinicHours_pkey")
    doctorId    String
    /// 0 = Sunday .. 6 = Saturday.
    weekday     Int
    openMinute  Int
    closeMinute Int
    doctor      Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "ClinicHours_doctorId_fkey")

    @@index([doctorId, weekday], map: "ClinicHours_doctorId_weekday_key", unique: true)

    @@map("ClinicHours")
  }

  /// A recurring break — lunch, a teaching slot. Null weekday means every day.
  model ClinicBreak {
    id          String  @id(map: "ClinicBreak_pkey")
    doctorId    String
    weekday     Int?
    startMinute Int
    endMinute   Int
    label       String
    doctor      Doctor  @relation(fields: [doctorId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "ClinicBreak_doctorId_fkey")

    @@index([doctorId], map: "ClinicBreak_doctorId_idx")

    @@map("ClinicBreak")
  }

  /// A one-off closure: a holiday, leave, or a blocked range within a day.
  /// `startMinute`/`endMinute` null means the whole day is blocked.
  model ClinicClosure {
    id          String      @id(map: "ClinicClosure_pkey")
    doctorId    String
    startsOn    DateString
    endsOn      DateString
    startMinute Int?
    endMinute   Int?
    reason      String
    doctor      Doctor      @relation(fields: [doctorId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "ClinicClosure_doctorId_fkey")

    @@index([doctorId, startsOn], map: "ClinicClosure_doctorId_startsOn_idx")

    @@map("ClinicClosure")
  }

  /// Overrides the built-in length for one service.
  model ServiceDuration {
    id       String              @id(map: "ServiceDuration_pkey")
    doctorId String
    service  pg.enum(ServiceType)
    minutes  Int
    doctor   Doctor              @relation(fields: [doctorId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "ServiceDuration_doctorId_fkey")

    @@index([doctorId, service], map: "ServiceDuration_doctorId_service_key", unique: true)

    @@map("ServiceDuration")
  }

  /// One state a record has held, kept forever.
  ///
  /// Version 1 is the text as first signed; each amendment appends the text it
  /// was changed to, with the reason. The newest version is therefore the same
  /// text as the record itself, and the older ones are never rewritten — so
  /// the trail answers "what did this note say when the decision was made",
  /// which is the question a clinical record exists to answer.
  model MedicalRecordVersion {
    id              String        @id(map: "MedicalRecordVersion_pkey")
    medicalRecordId String
    /// 1 for the original signature, then upwards.
    version         Int
    /// The clinical fields as they stood, JSON-encoded. Held as text because it
    /// is only ever read back whole, to show or compare one past version.
    snapshot        String
    /// Why the change was made. Null on the original signature — there is no
    /// prior state to explain.
    reason          String?
    authorId        String
    createdAt       TimestampString(3) @default(now())
    medicalRecord   MedicalRecord @relation(fields: [medicalRecordId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "MedicalRecordVersion_medicalRecordId_fkey", index: false)
    author          Doctor        @relation(fields: [authorId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "MedicalRecordVersion_authorId_fkey")

    @@index([medicalRecordId, version], map: "MedicalRecordVersion_recordId_version_key", unique: true)
    @@index([authorId], map: "MedicalRecordVersion_authorId_idx")

    @@map("MedicalRecordVersion")
  }


  /// A request for a document drawn from a patient's records.
  ///
  /// These are the things people come to a clinic's records desk for: a
  /// certificate for an employer, an abstract for a specialist, a medico-legal
  /// certificate for a case, a form for an insurer, copies for the patient
  /// themselves. Each is a release of clinical information to somebody, so each
  /// records who asked, what for, and who handed it over — the request is as
  /// much a part of the record as the document it produces.
  model DocumentRequest {
    id               String  @id(map: "DocumentRequest_pkey")
    clinicId         String?
    doctorId         String
    patientId        String
    /// The visit the document draws on, where it draws on one.
    medicalRecordId  String?
    type             pg.enum(DocumentType)
    status           pg.enum(DocumentRequestStatus) @default("REQUESTED")
    /// Why it is wanted. Never optional: a release with no stated purpose is
    /// one nobody can judge the reasonableness of afterwards.
    purpose          String
    /// Who asked, and what they are to the patient.
    requesterName     String
    requesterRelation String
    /// The fields particular to one kind of document, JSON-encoded. Held as
    /// text because each type reads its own shape back whole, and a column per
    /// field across five documents would be mostly nulls.
    details          String?
    notes            String?
    /// Set when the doctor chose to show this to the patient in their own
    /// portal. Releasing a document at the desk and publishing it to a login
    /// are different acts, so they are different fields.
    sharedWithPatientAt TimestampString(3)?
    /// Set when the document was handed over, and to whom it was handed.
    releasedAt       TimestampString(3)?
    releasedById     String?
    releasedTo       String?
    declineReason    String?
    createdAt        TimestampString(3) @default(now())
    updatedAt        TimestampString(3)
    doctor           Doctor        @relation(name: "DocumentRequest_doctorId_fkey", fields: [doctorId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "DocumentRequest_doctorId_fkey")
    clinic           Clinic?       @relation(fields: [clinicId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "DocumentRequest_clinicId_fkey")
    releasedBy       Doctor?       @relation(name: "DocumentRequest_releasedById_fkey", fields: [releasedById], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "DocumentRequest_releasedById_fkey")
    patient          Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "DocumentRequest_patientId_fkey")
    medicalRecord    MedicalRecord? @relation(fields: [medicalRecordId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "DocumentRequest_medicalRecordId_fkey")

    @@index([doctorId, status], map: "DocumentRequest_doctorId_status_idx")
    @@index([patientId], map: "DocumentRequest_patientId_idx")
    @@index([clinicId, status], map: "DocumentRequest_clinicId_status_idx")
    @@index([medicalRecordId], map: "DocumentRequest_medicalRecordId_idx")
    @@index([releasedById], map: "DocumentRequest_releasedById_idx")

    @@map("DocumentRequest")
  }


  /// The practice itself: what owns the records, rather than any one person.
  ///
  /// Everything clinical used to hang off a single Doctor row, which was also
  /// the login. That works until somebody else has to answer the phone. A
  /// clinic owns the charts; people are members of it with a role, and the
  /// clinician who wrote a note stays recorded on the note.
  model Clinic {
    id            String @id(map: "Clinic_pkey")
    name          String
    address       String?
    contactNumber String?
    createdAt     TimestampString(3) @default(now())
    updatedAt     TimestampString(3)
    members       ClinicMember[]
    doctors       Doctor[]
    households    Household[]
    appointments  Appointment[]
    medicalRecords MedicalRecord[]
    documentRequests DocumentRequest[]
    staffInvites  StaffInvite[]
    patientActivations PatientActivation[]
    appointmentRequests AppointmentRequest[]
    patients      Patient[]

    @@map("Clinic")
  }

  /// Somebody who can sign in — a doctor, a secretary, or a patient.
  ///
  /// Deliberately not the same thing as a Patient. A patient exists in the
  /// chart whether or not they ever log in, and a person who logs in is not
  /// automatically anybody's patient; conflating the two is how a login ends up
  /// granting access to a record it was never meant to reach.
  model Account {
    id           String @id(map: "Account_pkey")
    email        String
    passwordHash String
    fullName     String
    /// Sessions issued before this instant stop being accepted.
    ///
    /// The cookie is a stateless JWT, so there is otherwise no way to end a
    /// session that is already out there — signing out only clears the
    /// browser's own copy. Bumping this on a password change or reset is what
    /// makes either of them actually evict anybody. Null means every session
    /// is still good, which is the ordinary case.
    sessionsValidFrom TimestampString(3)?
    createdAt    TimestampString(3) @default(now())
    updatedAt    TimestampString(3)
    memberships  ClinicMember[]
    doctorProfile Doctor?
    patientProfile Patient?
    invitesSent  StaffInvite[]       @relation(name: "StaffInvite_invitedById_fkey")
    invitesAccepted StaffInvite[]    @relation(name: "StaffInvite_acceptedById_fkey")
    activationsIssued PatientActivation[]
    bookingsMade Appointment[]       @relation(name: "Appointment_bookedById_fkey")
    requestsMade AppointmentRequest[] @relation(name: "AppointmentRequest_requestedById_fkey")
    requestsDecided AppointmentRequest[] @relation(name: "AppointmentRequest_decidedById_fkey")
    passwordResets PasswordReset[]

    @@index([email], map: "Account_email_key", unique: true)

    @@map("Account")
  }

  /// What one account may do in one clinic.
  ///
  /// Membership is the permission. An account with no membership in a clinic
  /// has no way to reach anything of that clinic's, whatever else it may be
  /// elsewhere.
  model ClinicMember {
    id        String @id(map: "ClinicMember_pkey")
    clinicId  String
    accountId String
    role      pg.enum(ClinicRole)
    createdAt TimestampString(3) @default(now())
    updatedAt TimestampString(3)
    clinic    Clinic  @relation(fields: [clinicId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "ClinicMember_clinicId_fkey", index: false)
    account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "ClinicMember_accountId_fkey")

    @@index([clinicId, accountId], map: "ClinicMember_clinicId_accountId_key", unique: true)
    @@index([accountId], map: "ClinicMember_accountId_idx")

    @@map("ClinicMember")
  }

  /// An invitation for somebody to join a clinic as staff.
  ///
  /// The token is stored hashed and handed out once, so the row cannot be read
  /// out of the database and used. Staff exist only because an existing member
  /// asked for them — there is no way to sign up as staff from outside.
  model StaffInvite {
    id            String @id(map: "StaffInvite_pkey")
    clinicId      String
    email         String
    role          pg.enum(ClinicRole)
    tokenHash     String
    invitedById   String
    expiresAt     TimestampString(3)
    acceptedAt    TimestampString(3)?
    acceptedById  String?
    revokedAt     TimestampString(3)?
    createdAt     TimestampString(3) @default(now())
    clinic        Clinic  @relation(fields: [clinicId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "StaffInvite_clinicId_fkey", index: false)
    invitedBy     Account @relation(name: "StaffInvite_invitedById_fkey", fields: [invitedById], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "StaffInvite_invitedById_fkey")
    acceptedBy    Account? @relation(name: "StaffInvite_acceptedById_fkey", fields: [acceptedById], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "StaffInvite_acceptedById_fkey")

    @@index([tokenHash], map: "StaffInvite_tokenHash_key", unique: true)
    @@index([clinicId], map: "StaffInvite_clinicId_idx")
    @@index([invitedById], map: "StaffInvite_invitedById_idx")
    @@index([acceptedById], map: "StaffInvite_acceptedById_idx")

    @@map("StaffInvite")
  }

  /// A one-time code that ties a new login to one existing patient record.
  ///
  /// This is the only way a login becomes a patient's own. A name and an email
  /// are not evidence of identity — two people share both often enough — so the
  /// clinic issues a code to somebody it has identified at the desk, and the
  /// code says which chart it opens.
  model PatientActivation {
    id           String @id(map: "PatientActivation_pkey")
    clinicId     String
    patientId    String
    tokenHash    String
    issuedById   String
    expiresAt    TimestampString(3)
    usedAt       TimestampString(3)?
    revokedAt    TimestampString(3)?
    createdAt    TimestampString(3) @default(now())
    clinic       Clinic  @relation(fields: [clinicId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "PatientActivation_clinicId_fkey", index: false)
    patient      Patient @relation(fields: [patientId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "PatientActivation_patientId_fkey")
    issuedBy     Account @relation(fields: [issuedById], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "PatientActivation_issuedById_fkey")

    @@index([tokenHash], map: "PatientActivation_tokenHash_key", unique: true)
    @@index([patientId], map: "PatientActivation_patientId_idx")
    @@index([clinicId], map: "PatientActivation_clinicId_idx")
    @@index([issuedById], map: "PatientActivation_issuedById_idx")

    @@map("PatientActivation")
  }

  /// A patient asking for a time, which staff then accept or decline.
  ///
  /// Deliberately not an Appointment. A request holds no slot: it is a wish,
  /// and letting a wish block the calendar would let anybody empty it. The slot
  /// is taken at the moment staff accept, through the same booking lock and
  /// overlap check as any other booking — so an accepted request can still fail
  /// because the time went, and says so.
  model AppointmentRequest {
    id                String @id(map: "AppointmentRequest_pkey")
    clinicId          String
    patientId         String
    doctorId          String
    requestedById     String
    preferredDate     DateString
    /// "HH:MM" in clinic time, or null for "any time that day".
    preferredTime     String?
    service           pg.enum(ServiceType)
    reason            String
    status            pg.enum(AppointmentRequestStatus) @default("PENDING")
    /// Set when accepting produced a booking.
    appointmentId     String?
    decisionNote      String?
    decidedById       String?
    decidedAt         TimestampString(3)?
    createdAt         TimestampString(3) @default(now())
    updatedAt         TimestampString(3)
    clinic            Clinic  @relation(fields: [clinicId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "AppointmentRequest_clinicId_fkey", index: false)
    patient           Patient @relation(fields: [patientId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "AppointmentRequest_patientId_fkey")
    doctor            Doctor  @relation(fields: [doctorId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "AppointmentRequest_doctorId_fkey")
    requestedBy       Account @relation(name: "AppointmentRequest_requestedById_fkey", fields: [requestedById], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "AppointmentRequest_requestedById_fkey")
    decidedBy         Account? @relation(name: "AppointmentRequest_decidedById_fkey", fields: [decidedById], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "AppointmentRequest_decidedById_fkey")
    appointment       Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "AppointmentRequest_appointmentId_fkey")

    @@index([clinicId, status], map: "AppointmentRequest_clinicId_status_idx")
    @@index([patientId], map: "AppointmentRequest_patientId_idx")
    @@index([doctorId], map: "AppointmentRequest_doctorId_idx")
    @@index([requestedById], map: "AppointmentRequest_requestedById_idx")
    @@index([decidedById], map: "AppointmentRequest_decidedById_idx")
    @@index([appointmentId], map: "AppointmentRequest_appointmentId_idx")

    @@map("AppointmentRequest")
  }


  /// A one-time link for somebody who cannot get in.
  ///
  /// Same shape as PatientActivation on purpose — the token helpers, the
  /// hash-only storage and the used/revoked/expired checks are all the same
  /// problem, and a second way of doing it would be a second way to get it
  /// wrong.
  model PasswordReset {
    id         String @id(map: "PasswordReset_pkey")
    accountId  String
    tokenHash  String
    expiresAt  TimestampString(3)
    usedAt     TimestampString(3)?
    revokedAt  TimestampString(3)?
    createdAt  TimestampString(3) @default(now())
    account    Account @relation(fields: [accountId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "PasswordReset_accountId_fkey")

    @@index([tokenHash], map: "PasswordReset_tokenHash_key", unique: true)
    @@index([accountId], map: "PasswordReset_accountId_idx")

    @@map("PasswordReset")
  }

  model Prescription {
    id              String        @id(map: "Prescription_pkey")
    medicalRecordId String
    drugName        String
    dosage          String
    frequency       String
    duration        String?
    instructions    String?
    createdAt       TimestampString(3)  @default(now())
    medicalRecord   MedicalRecord @relation(fields: [medicalRecordId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "Prescription_medicalRecordId_fkey")

    @@index([medicalRecordId], map: "Prescription_medicalRecordId_idx")

    @@map("Prescription")
  }

  native_enum AllergySeverity {
    MILD = "MILD"
    MODERATE = "MODERATE"
    SEVERE = "SEVERE"
  }

  native_enum AppointmentStatus {
    PENDING = "PENDING"
    CONFIRMED = "CONFIRMED"
    CHECKED_IN = "CHECKED_IN"
    COMPLETED = "COMPLETED"
    CANCELLED = "CANCELLED"
    NO_SHOW = "NO_SHOW"
    // Appended rather than slotted in after CHECKED_IN, where it belongs in the
    // queue's order: Postgres native enums can only be added to, and Prisma
    // Next refuses anything that would reorder existing values. The order staff
    // see comes from APPOINTMENT_STATUS_LABELS, not from this declaration.
    IN_CONSULTATION = "IN_CONSULTATION"
  }

  native_enum AppointmentType {
    IN_PERSON = "IN_PERSON"
    TELECONSULTATION = "TELECONSULTATION"
    HOME_VISIT = "HOME_VISIT"
  }

  native_enum BloodType {
    A_POS = "A_POS"
    A_NEG = "A_NEG"
    B_POS = "B_POS"
    B_NEG = "B_NEG"
    AB_POS = "AB_POS"
    AB_NEG = "AB_NEG"
    O_POS = "O_POS"
    O_NEG = "O_NEG"
    UNKNOWN = "UNKNOWN"
