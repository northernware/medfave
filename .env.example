# Any PostgreSQL connection string. Prisma 8 reads it here and in prisma.config.ts;
# a hosted database (Prisma Postgres, Neon, Supabase, RDS) drops in unchanged.
# Bring a fresh one up to the contract with `npm run db:migrate`.
DATABASE_URL="postgres://postgres:postgres@localhost:5432/medikonek?sslmode=disable"

# Signing key for the session cookie — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=""

# Email, via Resend (https://resend.com). Optional: without these, codes are
# still issued and shown on screen — mail is a convenience, never the only
# copy of a credential.
#
# EMAIL_FROM must be an address at a domain verified in your Resend account;
# "onboarding@resend.dev" works for testing but only delivers to the address
# that owns the Resend account.
RESEND_API_KEY=""
EMAIL_FROM="MediKonek <onboarding@resend.dev>"

# Where links in emails point. Must be reachable by whoever receives them.
APP_URL="http://localhost:3000"

# Logs messages instead of sending them — for working on the wording without
# a Resend account, and without posting test mail to a real address.
EMAIL_DRY_RUN="0"

# Shared secret for /api/cron/reminders, so a scheduler can send the day-before
# reminders without a session. Unset means that endpoint is disabled.
CRON_SECRET=""
